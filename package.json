{
  "name": "3d-studio-windows-rc",
  "version": "5.3.1-rc.1",
  "private": true,
  "description": "3D Studio experimental Windows desktop build",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run verify:gateway && electron-builder --win nsis --x64",
    "verify:gateway": "node scripts/verify-gateway.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studio3d.desktop",
    "productName": "3D Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json",
      "app/index.html",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "app/dist/studio-gateway.exe",
        "to": "studio-gateway.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/index.html",
        "to": "web/index.html"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3D Studio"
    }
  }
}