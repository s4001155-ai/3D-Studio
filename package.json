
{
  "name": "3d-studio",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "3D Studio - experimental Windows desktop release",
  "author": "3D Studio Contributors",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node copy-vendor.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "three": "0.161.0"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.threedstudio.editor",
    "productName": "3D Studio",
    "asar": true,
    "files": [
      "main.cjs",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "3D-Studio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "3D-Studio-Portable-${version}-${arch}.${ext}"
    }
  }
}
