{
  "name": "3d-studio-windows-test",
  "version": "5.3.3-beta.1",
  "private": true,
  "description": "3D Studio Windows desktop experimental STL import test",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "verify:gateway": "node scripts/verify-gateway.cjs",
    "dist:win": "npm run verify:gateway && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studio3d.desktop.test",
    "productName": "3D Studio Test",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/dist/studio-gateway.exe",
        "to": "studio-gateway.exe"
      },
      {
        "from": "app/index.html",
        "to": "web/index.html"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}