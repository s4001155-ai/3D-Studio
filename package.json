{
  "name": "3d-studio-windows-rc",
  "version": "0.5.3-beta.1",
  "private": true,
  "description": "3D Studio Windows/macOS cloud-search public beta source",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run verify:gateway && electron-builder --win nsis --x64 --publish never",
    "verify:gateway": "node scripts/verify-gateway.cjs",
    "dist:mac": "npm run verify:gateway && electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studio3d.desktop",
    "productName": "3D Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "package.json",
      "app/index.html",
      "preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "app/dist/studio-gateway.exe",
          "to": "studio-gateway.exe"
        },
        {
          "from": "app/index.html",
          "to": "web/index.html"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3D Studio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "app/dist/studio-gateway",
          "to": "studio-gateway"
        },
        {
          "from": "app/index.html",
          "to": "web/index.html"
        }
      ]
    }
  }
}